{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rulelink:schema:publication-coverage:v1",
  "title": "RuleLink publication coverage unit v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "coverage_unit_id",
    "question_family_id",
    "procedure_stage_id",
    "jurisdiction",
    "as_of_policy",
    "risk_level",
    "target_authority_level",
    "branch_signature",
    "canonical_content_ids",
    "required_rule_ids",
    "required_scenario_ids",
    "required_source_coordinate_ids",
    "source_version_requirements",
    "required_authority_binding_ids",
    "evaluation_case_ids"
  ],
  "properties": {
    "coverage_unit_id": {
      "type": "string",
      "pattern": "^coverage\\.kr\\.[a-z0-9.-]+\\.v[1-9][0-9]*$"
    },
    "question_family_id": {
      "type": "string",
      "pattern": "^question\\.[a-z0-9.-]+$"
    },
    "procedure_stage_id": {
      "type": "string",
      "pattern": "^procedure\\.[a-z0-9.-]+$"
    },
    "jurisdiction": {
      "const": "KR"
    },
    "as_of_policy": {
      "enum": [
        "current_as_of_review",
        "historical",
        "future_effective"
      ]
    },
    "risk_level": {
      "enum": [
        "standard",
        "high",
        "critical"
      ]
    },
    "target_authority_level": {
      "enum": [
        "L1_coordinate",
        "L2_locator"
      ]
    },
    "branch_signature": {
      "$ref": "#/$defs/nonEmptyUniqueStrings"
    },
    "canonical_content_ids": {
      "$ref": "#/$defs/nonEmptyUniqueStrings"
    },
    "required_rule_ids": {
      "$ref": "#/$defs/nonEmptyUniqueStrings"
    },
    "required_scenario_ids": {
      "$ref": "#/$defs/nonEmptyUniqueStrings"
    },
    "required_source_coordinate_ids": {
      "$ref": "#/$defs/nonEmptyUniqueStrings"
    },
    "source_version_requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "coordinate_id",
          "source_snapshot_id",
          "last_verified_at"
        ],
        "properties": {
          "coordinate_id": {
            "type": "string",
            "minLength": 1
          },
          "source_snapshot_id": {
            "type": "string",
            "minLength": 1
          },
          "last_verified_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "required_authority_binding_ids": {
      "$ref": "#/$defs/uniqueStrings"
    },
    "evaluation_case_ids": {
      "$ref": "#/$defs/uniqueStrings"
    }
  },
  "$defs": {
    "uniqueStrings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "nonEmptyUniqueStrings": {
      "allOf": [
        {
          "$ref": "#/$defs/uniqueStrings"
        },
        {
          "minItems": 1
        }
      ]
    }
  }
}
